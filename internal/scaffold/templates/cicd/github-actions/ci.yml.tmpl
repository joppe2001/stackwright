name: ci
on:
  push:
    branches: [main]
  pull_request: {}

jobs:
{{- if eq (index .Stack "frontend") "nextjs-14"}}
  web:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: "npm"
      - run: npm ci
      - run: npm run lint --if-present
      - run: npm run build
{{- end}}
{{- if eq (index .Stack "backend") "go-chi"}}
  api:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: api
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version: "1.22"
      - run: go mod download
      - run: go vet ./...
      - run: go test ./... -race
{{- end}}
