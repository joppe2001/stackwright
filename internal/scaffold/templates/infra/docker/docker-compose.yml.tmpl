services:
  app:
    build: .
    ports:
      {{- if eq (index .Stack "backend") "go-chi"}}
      - "8080:8080"
      {{- else}}
      - "3000:3000"
      {{- end}}
    env_file: .env
{{- if eq (index .Stack "database") "postgres-16"}}
    environment:
      DATABASE_URL: "postgres://postgres:postgres@db:5432/{{.DBName}}?sslmode=disable"
    depends_on: [db]
  db:
    image: postgres:16-alpine
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: {{.DBName}}
    ports: ["5432:5432"]
    volumes:
      - pgdata:/var/lib/postgresql/data
      - ./db/init.sql:/docker-entrypoint-initdb.d/init.sql:ro
volumes:
  pgdata:
{{- end}}
