generator client {
  provider = "prisma-client-js"
}

datasource db {
  {{- if eq (index .Stack "database") "planetscale"}}
  provider     = "mysql"
  relationMode = "prisma"
  {{- else}}
  provider = "postgresql"
  {{- end}}
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
